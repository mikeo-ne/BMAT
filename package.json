{
  "name": "east-sound",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:static": "bash scripts/build-static.sh",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:validate": "prisma validate",
    "test:browser": "playwright test",
    "db:migrate": "node --conditions=react-server --import tsx scripts/database.ts migrate",
    "db:seed": "node --conditions=react-server --import tsx scripts/database.ts seed",
    "worker:notifications": "node --conditions=react-server --import tsx scripts/notification-worker.ts",
    "test:postgres": "vitest run --config vitest.postgres.config.mts",
    "test:deployment": "playwright test --config playwright.deployment.config.ts"
  },
  "dependencies": {
    "dotenv": "^18.0.9",
    "geist": "^1.7.2",
    "hls.js": "^1.7.4",
    "lucide-react": "^0.453.0",
    "next": "16.3.4",
    "pdf-lib": "^1.17.1",
    "pg": "^8.23.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "3.10.1",
    "server-only": "^0.0.1",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@prisma/internals": "^6.19.3",
    "@tailwindcss/postcss": "^4",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "embedded-postgres": "^18.6.0-beta.19",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "jsdom": "^30.0.1",
    "prisma": "^6.19.3",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": "22.x"
  }
}
