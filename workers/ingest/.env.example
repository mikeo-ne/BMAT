# Leave both empty for DRY RUN (detections → data/out/*.jsonl + evidence MP3s).
SUPABASE_URL=
# Service-role key: SERVER ONLY. Never put this in the Next.js app or a browser.
SUPABASE_SERVICE_ROLE_KEY=

EST_INDEX_PATH=data/fingerprints.db
EST_OUT_DIR=data/out
EST_EVIDENCE_BUCKET=evidence
# Tuning (seconds)
# EST_WINDOW_SEC=10
# EST_STEP_SEC=4
# EST_END_GAP_SEC=16
# Hosting: Railway uses railway.json, Fly uses fly.toml — both run the same image.
# EST_EVIDENCE_DIR / EST_EVIDENCE_PUBLIC_BASE are only needed by the legacy
# playout sink; the Supabase sink writes clips to the private evidence bucket.

# ── Brand mentions (spoken on air) — off unless EST_MENTIONS=1 ──────────────
# EST_MENTIONS=1
# EST_ASR_MODEL=base.en         # base.en (~9× real time on 2 cores) or small.en (more accurate, ~2.5×; give it ~4 cores)
# EST_ASR_THREADS=2
# EST_ASR_BACKLOG=6             # chunks allowed to wait; older ones are skipped if the CPU falls behind
# EST_MODEL_DIR=/app/data/models  # downloaded once (base.en ≈ 210 MB, small.en ≈ 640 MB), kept on the volume
# Luganda-capable alternative (needs a GPU to keep up; pip install faster-whisper):
# EST_ASR_ENGINE=faster-whisper
# EST_ASR_MODEL=Sunbird/faster-whisper-51-african-languages
# EST_ASR_LANGUAGE=sd
