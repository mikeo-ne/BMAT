// Master entity schema (7H Music Group Ltd).
// Canonical Supabase-style entity structure, adapted to the project's
// east_sound PostgreSQL schema. Active persistence uses db/migrations and
// lib/postgres with a dedicated east_sound schema. Do NOT prisma db push
// this draft over it. See docs/postgres-and-worker.md for boundaries.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CMO
  LABEL
  ARTIST
  BROADCASTER
  VENUE
}

enum BroadcastType {
  RADIO_FM
  TV_DIGITAL
  WEB_RADIO
  WEB_TV
}

enum StreamProtocol {
  ICECAST
  HLS
  SHOUTCAST
  HTTP_MP3
  RTSP
}

enum VenueCategory {
  BAR_LOUNGE
  NIGHTCLUB
  RESTAURANT
  HOTEL
  EVENT_SPACE
}

enum DisputeStatus {
  PENDING
  UNDER_REVIEW
  RESOLVED
  REJECTED
}

model Profile {
  id              String     @id @default(cuid())
  email           String
  fullName        String?
  role            UserRole   @default(ARTIST)
  organizationName String?
  phoneNumber     String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  labels         Label[]
  artists        Artist[]
  broadcastStations BroadcastStation[]
  venues         Venue[]
  disputes       Dispute[] @relation("DisputeFiledBy")

  @@map("profiles")
}

model Label {
  id        String   @id @default(cuid())
  profileId String
  labelName String
  country   String   @default("Uganda")
  createdAt DateTime @default(now())

  profile Profile @relation(fields: [profileId], references: [id])
  artists Artist[]
  tracks  Track[]

  @@map("labels")
}

model Artist {
  id         String   @id @default(cuid())
  profileId  String?
  labelId    String?
  stageName  String
  realName   String?
  isrcPrefix String   @default("UG-ESD")
  createdAt  DateTime @default(now())

  profile Profile? @relation(fields: [profileId], references: [id])
  label   Label?    @relation(fields: [labelId], references: [id])
  tracks  Track[]

  @@map("artists")
}

model Track {
  id           String   @id @default(cuid())
  artistId     String
  labelId      String?
  title        String
  isrc         String   @unique
  upc          String?
  audioFileUrl String
  fingerprintHash String?
  genre        String   @default("Afro-fusion")
  releaseDate  DateTime?
  createdAt    DateTime @default(now())

  artist Artist @relation(fields: [artistId], references: [id])
  label  Label? @relation(fields: [labelId], references: [id])

  splits    TrackSplit[]
  disputes  Dispute[]
  stationLogs StationPlayoutLog[]
  venueLogs   VenuePlayoutLog[]

  @@map("tracks")
}

model TrackSplit {
  id               String  @id @default(cuid())
  trackId          String
  contributorName  String
  role             String  // Producer | Composer | Writer | Publisher
  sharePercentage  Float
  createdAt        DateTime @default(now())

  track Track @relation(fields: [trackId], references: [id], onDelete: Cascade)

  @@map("track_splits")
}

model BroadcastStation {
  id             String        @id @default(cuid())
  profileId      String?
  stationName    String
  broadcastType  BroadcastType @default(RADIO_FM)
  frequencyFm    String?
  region         String        @default("Central")
  streamUrl      String
  protocol       StreamProtocol @default(ICECAST)
  isActive       Boolean       @default(true)
  lastPingAt     DateTime      @default(now())
  createdAt      DateTime      @default(now())

  profile Profile? @relation(fields: [profileId], references: [id])
  logs    StationPlayoutLog[]

  @@map("broadcast_stations")
}

model Venue {
  id             String        @id @default(cuid())
  profileId      String?
  venueName      String
  category       VenueCategory @default(BAR_LOUNGE)
  district       String        @default("Kampala")
  address        String?
  uprsLicenseNo  String?
  isCompliant    Boolean       @default(true)
  createdAt      DateTime      @default(now())

  profile Profile? @relation(fields: [profileId], references: [id])
  logs    VenuePlayoutLog[]

  @@map("venues")
}

model StationPlayoutLog {
  id              String   @id @default(cuid())
  stationId       String
  trackId         String?
  matchedTitle    String
  matchedArtist   String
  confidenceScore Float    @default(99.0)
  playoutType     String   @default("music")
  playedAt        DateTime @default(now())

  station BroadcastStation @relation(fields: [stationId], references: [id], onDelete: Cascade)
  track   Track?           @relation(fields: [trackId], references: [id])

  @@map("station_playout_logs")
}

model VenuePlayoutLog {
  id              String   @id @default(cuid())
  venueId         String
  trackId         String?
  matchedTitle    String
  matchedArtist   String
  confidenceScore Float    @default(98.5)
  playedAt        DateTime @default(now())

  venue  Venue @relation(fields: [venueId], references: [id], onDelete: Cascade)
  track  Track? @relation(fields: [trackId], references: [id])

  @@map("venue_playout_logs")
}

model Dispute {
  id               String        @id @default(cuid())
  trackId          String
  filedByProfileId String
  disputeReason    String
  status           DisputeStatus @default(PENDING)
  resolutionNotes  String?
  createdAt        DateTime      @default(now())

  track   Track   @relation(fields: [trackId], references: [id], onDelete: Cascade)
  filedBy Profile @relation("DisputeFiledBy", fields: [filedByProfileId], references: [id])

  @@map("disputes")
}
