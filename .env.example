# Supabase project (Settings → API). Leave empty to run in DEMO MODE
# (local session, seeded data, no emails sent).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Public site URL — used for password-recovery and email-confirmation redirects.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Alert sender (server only — never prefix these with NEXT_PUBLIC_) ──────
# Shared secret the scheduler sends; without it /api/cron/alerts refuses to run.
CRON_SECRET=
# Service-role key: only the ingest worker and the alert sender hold it.
SUPABASE_SERVICE_ROLE_KEY=

# WhatsApp Cloud API (Meta). Leave empty to skip WhatsApp entirely.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TOKEN=

# …or email through Resend (used when someone has no phone number saved).
RESEND_API_KEY=
ALERT_FROM_EMAIL=alerts@example.com
