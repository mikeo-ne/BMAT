# Copy to ignored .env for local development; CLI tools read .env too.
# Never commit real credentials. No NEXT_PUBLIC_* secrets.
# For Arena/live previews set this to the exact externally visible HTTPS origin.
EAST_SOUND_APP_ORIGIN=http://localhost:3000
EAST_SOUND_STORAGE_BACKEND=file
# Default .data must be a private durable volume, never a public/static directory.
# EAST_SOUND_DATA_DIR=/absolute/private/durable/path

# Explicitly simulated Google/Microsoft flow; disabled in production even if 1.
EAST_SOUND_MOCK_OAUTH=0

# Live sends and workers remain disabled until deliberately configured.
EAST_SOUND_LIVE_NOTIFICATIONS=false
EAST_SOUND_WORKER_ENABLED=0
# Independently generated random secrets, at least 32 characters each:
# EAST_SOUND_INGEST_TOKEN=
# EAST_SOUND_NOTIFICATION_TOKEN=

# Production/PostgreSQL: generate 32 random bytes, encode as 64 hex characters.
# Set BEFORE storing webhook secrets; back up separately with the matching data.
# Local file mode otherwise creates .data/security/notification.key (0600).
# EAST_SOUND_SECRET_KEY=

# Optional PostgreSQL: explicitly set backend=postgres, then db:migrate/db:seed.
# Remote TLS must use sslmode=verify-full with a trusted certificate chain.
# DATABASE_URL=
# For provider-managed URLs with sslmode=require, this explicitly strengthens
# runtime TLS to certificate + hostname verification without editing the secret:
# EAST_SOUND_POSTGRES_TLS=verify-full
# EAST_SOUND_TENANT_ID=
# Only for separately managed administrative rule-registration, not user login:
# EAST_SOUND_NOTIFICATION_USER_ID=

# WhatsApp Business: use real approved sender/template/current graph version.
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_GRAPH_VERSION=
# WHATSAPP_TEMPLATE_NAME=
# WHATSAPP_TEMPLATE_LANGUAGE=en

# Optional email provider; verified sender required.
# RESEND_API_KEY=
# EAST_SOUND_EMAIL_FROM=

# Exact permitted webhook URL strings (not origin-only wildcards).
EAST_SOUND_WEBHOOK_ALLOWLIST=[]
# Legacy integration fallback HMAC secret (32+ random characters), if needed:
# EAST_SOUND_WEBHOOK_SECRET=

# account:create reads password from stdin or EAST_SOUND_ACCOUNT_PASSWORD.
# Do not persist an operator/account password in this example or shell history.
