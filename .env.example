# Supabase project (Settings → API). Leave empty to run in DEMO MODE
# (local session, seeded data, no emails sent).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Public site URL — used for password-recovery and email-confirmation redirects.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Alert sender (server only — never prefix these with NEXT_PUBLIC_) ──────
# Shared secret the scheduler sends; without it /api/cron/alerts refuses to run.
CRON_SECRET=
# Service-role key: only the ingest worker and the alert sender hold it.
SUPABASE_SERVICE_ROLE_KEY=

# WhatsApp Cloud API (Meta). Leave empty to skip WhatsApp entirely.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TOKEN=

# …or email through Resend (used when someone has no phone number saved).
RESEND_API_KEY=
ALERT_FROM_EMAIL=alerts@example.com

# ── Web push (optional) ────────────────────────────────────────────────────
# Generate once with: npx web-push generate-vapid-keys
# Without these, the "Enable phone notifications" control stays hidden and
# /api/push/send answers 503 instead of pretending to send.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:alerts@example.com

# ── Billing switch ─────────────────────────────────────────────────────────
# Off (default): plans are free, the pricing page says "Free during early
# access", and requests are stored with amount_ugx = 0.
# On: the same flow asks for a mobile-money number and an amount due.
NEXT_PUBLIC_PAYMENTS_ENABLED=false

# Optional: official Spotify Web API for "Add songs from links" (ISRC + UPC).
# From developer.spotify.com/dashboard → your app → Settings. Server-only; never NEXT_PUBLIC_.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Optional catalogue APIs (server only). Default OFF: do not enable until the
# provider confirms commercial access, attribution, storage and quota terms.
# MusicBrainz also requires migration 0029 and a descriptive contact User-Agent.
MUSICBRAINZ_ENABLED=false
MUSICBRAINZ_USER_AGENT=
# Audiomack OAuth 1.0a consumer credentials: set only in the server secret store.
AUDIOMACK_API_ENABLED=false
AUDIOMACK_CONSUMER_KEY=
AUDIOMACK_CONSUMER_SECRET=
